# Arquivos binários pesados (projetos fonte)
*.pdf
*.PDF
*.ifc
*.IFC
*.skp
*.dwg
*.dxf
*.rvt
*.zip
*.rar
*.7z
*.tar.gz

# Imagens
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff
*.tif
*.webp

# Secrets / configs sensíveis
scripts/slack_config.json
scripts/test_channel_access.py
scripts/upload_*.py
*.env
.env.*
.env.memorial
credentials*

# Apresentacoes (pptx pode passar de 100MB — GitHub bloqueia)
*.pptx

# Symlinks pro Google Drive (arquivos vivem no Drive, nao no git)
executivos
executivos/
executivos/entregues/
executivos/*/entregas/
executivos/*/_tmp/
projetos/
parametricos/
planejamento/

# Pastas locais de arquivo/backup/saida da aposentadoria do workspace legado
archive/
executivos_PRE-SYMLINK-bak/
output/
temp/
_tmp/

# Obsidian (estado visual e local por maquina)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Outros
*.pyc
__pycache__/
.DS_Store
*.tmp
.env.sensitive
node_modules/
memory/

# Downloads/tmp do agent parametrico — xlsx que ele baixa pro workspace
# durante análise de arquivos do Slack. Não são entregas, ficam locais.
analise_tmp*.xlsx
patricia_file*.xlsx
